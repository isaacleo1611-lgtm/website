<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Leobrain Technology</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap');

  :root{
    --navy:#0B2A4A; --navy-deep:#081D34; --blue:#1F6FD1; --blue-bright:#3A93F0;
    --ice:#EAF3FC; --white:#FFFFFF; --ink:#0B2A4A; --muted:#4C6B8A; --line:#CFE1F5; --power:#F4A100;
    --danger:#D64545; --success:#2E9E5B;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  body{font-family:'Inter',sans-serif; color:var(--ink); background:var(--ice);}
  a{color:inherit;}
  button{font-family:inherit; cursor:pointer;}
  .hidden{display:none !important;}

  /* ===== TOP NAV ===== */
  .topnav{
    background:linear-gradient(120deg,var(--navy-deep),var(--navy));
    color:var(--white); padding:12px 22px;
    display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px;
    position:sticky; top:0; z-index:50;
  }
  .topnav .brand{display:flex; align-items:center; gap:10px; font-family:'Poppins',sans-serif; font-weight:800; font-size:16px;}
  .topnav .brand svg{width:28px; height:28px;}
  .navlinks{display:flex; gap:8px; align-items:center; flex-wrap:wrap;}
  .navlinks button{
    background:transparent; border:1px solid rgba(255,255,255,0.35); color:var(--white);
    padding:7px 14px; border-radius:6px; font-size:12.5px; font-weight:600;
  }
  .navlinks button.active, .navlinks button:hover{background:var(--blue); border-color:var(--blue);}
  .navlinks .pill{
    background:var(--power); color:var(--navy-deep); border:none; font-weight:700;
  }

  .sheet{max-width:1040px; margin:0 auto; background:var(--white);}
  .page{padding:26px 24px 40px;}

  /* ===== HERO (home) ===== */
  .hero{
    display:grid; grid-template-columns:1.05fr 1.4fr;
    background:linear-gradient(135deg,var(--navy-deep),var(--navy) 55%,var(--blue) 130%);
    position:relative; overflow:hidden;
  }
  .hero::before{
    content:""; position:absolute; inset:0;
    background-image: radial-gradient(circle at 90% 10%, rgba(58,147,240,0.35), transparent 45%),
      repeating-linear-gradient(90deg, rgba(255,255,255,0.035) 0 1px, transparent 1px 26px),
      repeating-linear-gradient(0deg, rgba(255,255,255,0.035) 0 1px, transparent 1px 26px);
    pointer-events:none;
  }
  .brand-block{padding:34px 28px 30px; display:flex; flex-direction:column; justify-content:center; gap:14px; position:relative; z-index:1;}
  .logo-row{display:flex; align-items:center; gap:14px;}
  .logo-icon{width:56px; height:56px; flex:none;}
  .brand-name{font-family:'Poppins',sans-serif; font-weight:800; font-size:28px; line-height:1.05; color:var(--white);}
  .brand-sub{font-family:'Poppins',sans-serif; font-weight:600; font-size:12px; letter-spacing:1.5px; color:var(--blue-bright); margin-top:2px;}
  .motto{font-style:italic; color:#BFD8F5; font-size:13px;}
  .hero-right{padding:30px 30px 30px 10px; display:flex; flex-direction:column; justify-content:center; gap:10px; position:relative; z-index:1;}
  .hero-headline{font-family:'Poppins',sans-serif; font-weight:700; font-size:25px; color:var(--white); line-height:1.15;}
  .hero-headline em{font-style:normal; color:var(--power);}
  .hero-copy{color:#D3E4F7; font-size:13.5px; line-height:1.5; max-width:420px;}

  .icon-strip{display:flex; justify-content:space-between; gap:6px; padding:14px 22px; background:var(--ice); border-bottom:1px solid var(--line); flex-wrap:wrap;}
  .icon-item{display:flex; align-items:center; gap:8px; font-size:11px; font-weight:600; color:var(--navy);}
  .icon-circle{width:28px; height:28px; border-radius:50%; background:var(--white); border:2px solid var(--blue); display:flex; align-items:center; justify-content:center; flex:none;}

  .body-grid{display:grid; grid-template-columns:230px 1fr;}
  .sidebar{padding:24px 20px; border-right:1px solid var(--line);}
  .sidebar h2{font-family:'Poppins',sans-serif; font-size:19px; font-weight:800; color:var(--navy); margin-bottom:6px;}
  .sidebar p.lead{font-size:12px; color:var(--muted); line-height:1.5; margin-bottom:16px;}
  .svc{display:flex; gap:10px; padding:9px 0; border-bottom:1px dashed var(--line);}
  .svc:last-child{border-bottom:none;}
  .svc-dot{width:24px; height:24px; border-radius:8px; background:var(--navy); flex:none; display:flex; align-items:center; justify-content:center;}
  .svc-dot span{width:7px; height:7px; border-radius:50%; background:var(--power);}
  .svc h3{font-size:12px; font-weight:700; color:var(--navy);}
  .svc p{font-size:10.4px; color:var(--muted); line-height:1.3; margin-top:2px;}

  .main{padding:22px 22px 6px;}
  .section-title{display:flex; align-items:center; gap:10px; background:var(--navy); color:var(--white); font-family:'Poppins',sans-serif; font-weight:700; font-size:13.5px; padding:9px 14px; border-radius:6px; margin-bottom:12px;}
  .section-title .power-dot{width:9px; height:9px; border-radius:50%; background:var(--power);}
  .pkg-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin-bottom:18px;}
  .pkg{border:1px solid var(--line); border-radius:8px; overflow:hidden;}
  .pkg-head{padding:8px 12px; font-family:'Poppins',sans-serif; font-weight:700; font-size:11.5px; color:var(--white);}
  .pkg.basic .pkg-head{background:var(--power);}
  .pkg.mid .pkg-head{background:var(--blue);}
  .pkg.premium .pkg-head{background:var(--navy);}
  .pkg ul{list-style:none; padding:10px 12px 12px;}
  .pkg li{font-size:10.3px; padding-left:14px; position:relative; margin-bottom:5px; line-height:1.3;}
  .pkg li::before{content:"▸"; position:absolute; left:0; color:var(--blue); font-size:10px;}

  /* ===== FORM (request/feedback) ===== */
  .request-card{background:var(--ice); border:1px solid var(--line); border-radius:10px; padding:20px; margin:22px; }
  .request-card h3{font-family:'Poppins',sans-serif; color:var(--navy); font-size:16px; margin-bottom:4px;}
  .request-card p{font-size:12px; color:var(--muted); margin-bottom:14px;}
  .form-row{display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:10px;}
  .form-row.full{grid-template-columns:1fr;}
  input, textarea, select{
    width:100%; padding:10px 12px; border:1px solid var(--line); border-radius:6px;
    font-family:'Inter',sans-serif; font-size:13px; background:var(--white); color:var(--ink);
  }
  textarea{min-height:90px; resize:vertical;}
  .btn{
    background:var(--blue); color:var(--white); border:none; padding:10px 18px;
    border-radius:6px; font-weight:700; font-size:13px;
  }
  .btn:hover{background:var(--blue-bright);}
  .btn.ghost{background:transparent; border:1px solid var(--blue); color:var(--blue);}
  .btn.power{background:var(--power); color:var(--navy-deep);}
  .form-msg{font-size:12px; margin-top:8px; font-weight:600;}
  .form-msg.ok{color:var(--success);}
  .form-msg.err{color:var(--danger);}

  .footer{background:linear-gradient(120deg,var(--navy-deep),var(--navy)); color:var(--white); padding:18px 26px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px;}
  .footer .tag{font-family:'Poppins',sans-serif; font-style:italic; font-weight:600; font-size:14px; color:var(--power);}
  .footer .contact{font-size:11.5px; color:#D3E4F7; display:flex; gap:14px; flex-wrap:wrap;}

  /* ===== AUTH PAGES ===== */
  .auth-wrap{max-width:420px; margin:50px auto; background:var(--white); border:1px solid var(--line); border-radius:12px; padding:30px; box-shadow:0 10px 30px rgba(11,42,74,0.08);}
  .auth-wrap h2{font-family:'Poppins',sans-serif; color:var(--navy); font-size:20px; margin-bottom:4px;}
  .auth-wrap p.sub{font-size:12.5px; color:var(--muted); margin-bottom:18px;}
  .tabbar{display:flex; gap:6px; margin-bottom:18px; background:var(--ice); padding:4px; border-radius:8px;}
  .tabbar button{flex:1; padding:9px; border:none; background:transparent; border-radius:6px; font-weight:700; font-size:12.5px; color:var(--muted);}
  .tabbar button.active{background:var(--navy); color:var(--white);}
  .field{margin-bottom:12px;}
  .field label{display:block; font-size:11.5px; font-weight:600; color:var(--navy); margin-bottom:4px;}
  .hint{font-size:11px; color:var(--muted); margin-top:10px; text-align:center;}
  .hint b{color:var(--navy);}

  /* ===== DASHBOARDS ===== */
  .dash-head{display:flex; align-items:center; justify-content:space-between; margin-bottom:18px; flex-wrap:wrap; gap:10px;}
  .dash-head h1{font-family:'Poppins',sans-serif; color:var(--navy); font-size:22px;}
  .dash-head .sub{font-size:12.5px; color:var(--muted);}
  .tabs{display:flex; gap:8px; margin-bottom:18px; flex-wrap:wrap;}
  .tabs button{padding:8px 14px; border:1px solid var(--line); background:var(--white); border-radius:20px; font-size:12px; font-weight:700; color:var(--navy);}
  .tabs button.active{background:var(--navy); color:var(--white); border-color:var(--navy);}
  .card{border:1px solid var(--line); border-radius:10px; padding:16px; margin-bottom:12px; background:var(--white);}
  .card h4{font-family:'Poppins',sans-serif; color:var(--navy); font-size:13.5px; margin-bottom:4px;}
  .card .meta{font-size:10.5px; color:var(--muted); margin-bottom:6px;}
  .card p{font-size:12.5px; line-height:1.45;}
  .empty-note{font-size:12.5px; color:var(--muted); padding:14px; text-align:center; border:1px dashed var(--line); border-radius:8px;}

  /* ===== CHAT ===== */
  .chat-box{border:1px solid var(--line); border-radius:10px; overflow:hidden; display:flex; flex-direction:column; height:430px; max-width:560px;}
  .chat-header{background:var(--navy); color:var(--white); padding:12px 16px; font-weight:700; font-size:13px; display:flex; justify-content:space-between; align-items:center;}
  .chat-header .status{width:8px; height:8px; border-radius:50%; background:var(--success); display:inline-block; margin-right:6px;}
  .chat-messages{flex:1; overflow-y:auto; padding:14px; background:var(--ice); display:flex; flex-direction:column; gap:8px;}
  .bubble{max-width:75%; padding:8px 12px; border-radius:12px; font-size:12.5px; line-height:1.4;}
  .bubble.me{align-self:flex-end; background:var(--blue); color:var(--white); border-bottom-right-radius:2px;}
  .bubble.them{align-self:flex-start; background:var(--white); border:1px solid var(--line); border-bottom-left-radius:2px;}
  .bubble .t{display:block; font-size:9px; opacity:0.7; margin-top:3px;}
  .chat-input{display:flex; gap:8px; padding:10px; border-top:1px solid var(--line); background:var(--white);}
  .chat-input input{flex:1;}
  .chat-list-item{display:flex; justify-content:space-between; align-items:center; padding:10px 12px; border:1px solid var(--line); border-radius:8px; margin-bottom:8px; cursor:pointer;}
  .chat-list-item:hover{background:var(--ice);}
  .chat-list-item .name{font-weight:700; font-size:12.5px; color:var(--navy);}
  .chat-list-item .preview{font-size:11px; color:var(--muted);}
  .unread{background:var(--power); color:var(--navy-deep); font-size:9.5px; font-weight:800; padding:2px 7px; border-radius:10px;}

  @media (max-width:720px){
    .hero{grid-template-columns:1fr;}
    .body-grid{grid-template-columns:1fr;}
    .sidebar{border-right:none; border-bottom:1px solid var(--line);}
    .pkg-grid, .form-row{grid-template-columns:1fr;}
  }
</style>
</head>
