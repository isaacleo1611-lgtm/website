      <div class="field"><label>Username</label><input type="text" id="regUser"></div>
      <div class="field"><label>Email</label><input type="email" id="regEmail"></div>
      <div class="field"><label>Password</label><input type="password" id="regPass"></div>
      <button class="btn" style="width:100%" onclick="registerUser()">Register</button>
      <div id="regMsg" class="form-msg"></div>
    </div>
  </div>
</div>

<!-- ======================= USER DASHBOARD ======================= -->
<div id="view-userDash" class="page-view hidden">
  <div class="sheet page">
    <div class="dash-head">
      <div><h1 id="userWelcomeName">Welcome!</h1><div class="sub">Glad to have you here.</div></div>
      <button class="btn ghost" onclick="logoutUser()">Log Out</button>
    </div>

    <div class="card">
      <h4>Need something designed or fixed?</h4>
      <p>Browse our packages on the <a href="#" onclick="go('home')" style="color:var(--blue); font-weight:700;">Home page</a>, or start a live chat below and our team will help you right away.</p>
    </div>

    <div class="section-title" style="margin-top:18px;"><span class="power-dot"></span>LIVE CHAT WITH ADMIN</div>
    <button class="btn power" id="startChatBtn" onclick="openUserChat()">Start Live Chat with Admin</button>

    <div class="chat-box hidden" id="userChatBox" style="margin-top:14px;">
      <div class="chat-header"><span><span class="status"></span>Leobrain Support</span></div>
      <div class="chat-messages" id="userChatMessages"></div>
      <div class="chat-input">
        <input type="text" id="userChatInput" placeholder="Type a message...">
        <button class="btn" onclick="userSendMessage()">Send</button>
      </div>
    </div>
  </div>
</div>

<script>
/* ============ STORAGE HELPERS ============ */
async function getJSON(key, fallback){
  try{
    const r = await window.storage.get(key, true);
    return r ? JSON.parse(r.value) : fallback;
  }catch(e){ return fallback; }
}
async function setJSON(key, value){
  try{ await window.storage.set(key, JSON.stringify(value), true); }
  catch(e){ console.error('storage set failed', e); }
}

/* ============ NAVIGATION ============ */
let currentAdmin = null;
let currentUser = null;

function go(view){
  document.querySelectorAll('.page-view').forEach(v => v.classList.add('hidden'));
  document.getElementById('view-' + view).classList.remove('hidden');
  document.querySelectorAll('#navlinks button').forEach(b => b.classList.remove('active'));
  const navBtn = document.querySelector('#navlinks button[data-nav="' + view + '"]');
  if(navBtn) navBtn.classList.add('active');
  window.scrollTo(0,0);
}

document.querySelectorAll('#navlinks button[data-nav]').forEach(btn=>{
  btn.addEventListener('click', ()=>{
    const target = btn.getAttribute('data-nav');
    if(target === 'adminLogin' && currentAdmin){ go('adminDash'); return; }
    if(target === 'userAuth' && currentUser){ go('userDash'); return; }
    go(target);
  });
});

/* ============ FEEDBACK FORM (home) ============ */
document.getElementById('feedbackForm').addEventListener('submit', async (e)=>{
  e.preventDefault();
  const name = document.getElementById('fbName').value.trim();
  const email = document.getElementById('fbEmail').value.trim();
  const message = document.getElementById('fbMessage').value.trim();
  const msgEl = document.getElementById('fbMsg');
  msgEl.textContent = 'Sending...'; msgEl.className = 'form-msg';

  try{
    const res = await fetch('https://formspree.io/f/xppzqlow', {
      method:'POST',
      headers:{ 'Accept':'application/json', 'Content-Type':'application/json' },
      body: JSON.stringify({ name, email, message })
    });
    if(res.ok){
      const list = await getJSON('leobrain-feedback', []);
      list.unshift({ name, email, message, timestamp: new Date().toISOString() });
      await setJSON('leobrain-feedback', list);
      msgEl.textContent = 'Thanks! Your request has been sent.'; msgEl.className = 'form-msg ok';
      e.target.reset();
    } else {
      msgEl.textContent = 'Something went wrong — please try again.'; msgEl.className = 'form-msg err';
    }
  }catch(err){
    msgEl.textContent = 'Network error — please try again.'; msgEl.className = 'form-msg err';
  }
});

/* ============ ADMIN AUTH ============ */
const ADMIN_USER = 'admin';
const ADMIN_PASS = 'Leobrain@2026';

function adminLogin(){
  const u = document.getElementById('adminUser').value.trim();
  const p = document.getElementById('adminPass').value;
  const msgEl = document.getElementById('adminLoginMsg');
  if(u === ADMIN_USER && p === ADMIN_PASS){
    currentAdmin = u;
    document.getElementById('navAdminBtn').textContent = 'Admin Dashboard';
    go('adminDash');
    loadAdminRequests();
    loadAdminChatList();
    loadAdminUsers();
  } else {
    msgEl.textContent = 'Incorrect username or password.'; msgEl.className = 'form-msg err';
  }
}
function logoutAdmin(){
  currentAdmin = null;
  document.getElementById('navAdminBtn').textContent = 'Admin Login';
  go('home');
}

function setAdminTab(tab){
  ['requests','chats','users'].forEach(t=>{
    document.getElementById('adminTab-'+t).classList.toggle('hidden', t!==tab);
  });
  document.querySelectorAll('[data-atab]').forEach(b=>b.classList.toggle('active', b.dataset.atab===tab));
}

async function loadAdminRequests(){
  const list = await getJSON('leobrain-feedback', []);
  const box = document.getElementById('requestsList');
  if(list.length === 0){ box.innerHTML = '<div class="empty-note">No requests yet.</div>'; return; }
  box.innerHTML = list.map(f => `
    <div class="card">
      <h4>${escapeHtml(f.name)} <span style="color:var(--muted); font-weight:500;">(${escapeHtml(f.email)})</span></h4>
      <div class="meta">${new Date(f.timestamp).toLocaleString()}</div>
      <p>${escapeHtml(f.message)}</p>
    </div>`).join('');
}

async function loadAdminUsers(){
  const users = await getJSON('leobrain-users', []);
  const box = document.getElementById('usersList');
  if(users.length === 0){ box.innerHTML = '<div class="empty-note">No registered users yet.</div>'; return; }
  box.innerHTML = users.map(u => `
    <div class="card">
      <h4>${escapeHtml(u.username)}</h4>
      <div class="meta">${escapeHtml(u.email)} · joined ${new Date(u.joined).toLocaleDateString()}</div>
    </div>`).join('');
}

/* ============ USER AUTH ============ */
function setAuthTab(tab){
  document.getElementById('authLogin').classList.toggle('hidden', tab!=='login');
  document.getElementById('authRegister').classList.toggle('hidden', tab!=='register');
  document.getElementById('tabLoginBtn').classList.toggle('active', tab==='login');
  document.getElementById('tabRegisterBtn').classList.toggle('active', tab==='register');
}

async function registerUser(){
  const username = document.getElementById('regUser').value.trim();
  const email = document.getElementById('regEmail').value.trim();
  const password = document.getElementById('regPass').value;
  const msgEl = document.getElementById('regMsg');
  if(!username || !email || !password){
    msgEl.textContent = 'Please fill in all fields.'; msgEl.className = 'form-msg err'; return;
  }
  const users = await getJSON('leobrain-users', []);
  if(users.find(u => u.username.toLowerCase() === username.toLowerCase())){
    msgEl.textContent = 'That username is already taken.'; msgEl.className = 'form-msg err'; return;
  }
  users.push({ username, email, password, joined: new Date().toISOString() });
  await setJSON('leobrain-users', users);
  msgEl.textContent = 'Account created! You can log in now.'; msgEl.className = 'form-msg ok';
  setTimeout(()=> setAuthTab('login'), 900);
}

async function userLogin(){
  const username = document.getElementById('loginUser').value.trim();
  const password = document.getElementById('loginPass').value;
  const msgEl = document.getElementById('loginMsg');
  const users = await getJSON('leobrain-users', []);
  const match = users.find(u => u.username.toLowerCase() === username.toLowerCase() && u.password === password);
  if(!match){
    msgEl.textContent = 'Incorrect username or password.'; msgEl.className = 'form-msg err'; return;
  }
  currentUser = match.username;
  document.getElementById('navUserBtn').textContent = 'My Dashboard';
  document.getElementById('userWelcomeName').textContent = 'Welcome, ' + currentUser + '!';
  go('userDash');
}
function logoutUser(){
  currentUser = null;
  document.getElementById('navUserBtn').textContent = 'User Login / Register';
  document.getElementById('userChatBox').classList.add('hidden');
  go('home');
}

/* ============ LIVE CHAT ============ */
let userChatTimer = null;
let adminChatTimer = null;
let adminOpenChatUser = null;

function chatKey(username){ return 'leobrain-chat-' + username; }

async function openUserChat(){
  if(!currentUser){ go('userAuth'); return; }
  document.getElementById('userChatBox').classList.remove('hidden');
  const index = await getJSON('leobrain-chat-index', []);
  if(!index.includes(currentUser)){
    index.push(currentUser);
    await setJSON('leobrain-chat-index', index);
  }
  await renderUserChat();
  if(userChatTimer) clearInterval(userChatTimer);
  userChatTimer = setInterval(renderUserChat, 3500);
}

async function renderUserChat(){
  const thread = await getJSON(chatKey(currentUser), []);
  const box = document.getElementById('userChatMessages');
  box.innerHTML = thread.map(m => `
    <div class="bubble ${m.sender==='user' ? 'me' : 'them'}">${escapeHtml(m.text)}<span class="t">${new Date(m.timestamp).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'})}</span></div>
  `).join('') || '<div class="empty-note">Say hello — our team usually replies quickly.</div>';
  box.scrollTop = box.scrollHeight;
}

async function userSendMessage(){
  const input = document.getElementById('userChatInput');
  const text = input.value.trim();
  if(!text) return;
  const thread = await getJSON(chatKey(currentUser), []);
  thread.push({ sender:'user', text, timestamp: new Date().toISOString() });
  await setJSON(chatKey(currentUser), thread);
  input.value = '';
  renderUserChat();
}
document.getElementById('userChatInput').addEventListener('keydown', e=>{ if(e.key==='Enter') userSendMessage(); });

async function loadAdminChatList(){
  const index = await getJSON('leobrain-chat-index', []);
  const box = document.getElementById('adminChatList');
  if(index.length === 0){ box.innerHTML = '<div class="empty-note">No conversations yet.</div>'; return; }
  let html = '';
  for(const username of index){
    const thread = await getJSON(chatKey(username), []);
    const last = thread[thread.length-1];
    html += `<div class="chat-list-item" onclick="openAdminChat('${username}')">
      <div><div class="name">${escapeHtml(username)}</div><div class="preview">${last ? escapeHtml(last.text).slice(0,28) : 'No messages yet'}</div></div>
    </div>`;
  }
  box.innerHTML = html;
  if(adminChatTimer) clearInterval(adminChatTimer);
  adminChatTimer = setInterval(()=>{ loadAdminChatList(); if(adminOpenChatUser) renderAdminChat(); }, 4000);
}

async function openAdminChat(username){
  adminOpenChatUser = username;
  document.getElementById('adminChatEmpty').classList.add('hidden');
  document.getElementById('adminChatBox').classList.remove('hidden');
  document.getElementById('adminChatWith').textContent = username;
  await renderAdminChat();
}

async function renderAdminChat(){
  if(!adminOpenChatUser) return;
  const thread = await getJSON(chatKey(adminOpenChatUser), []);
  const box = document.getElementById('adminChatMessages');
  box.innerHTML = thread.map(m => `
    <div class="bubble ${m.sender==='admin' ? 'me' : 'them'}">${escapeHtml(m.text)}<span class="t">${new Date(m.timestamp).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'})}</span></div>
  `).join('');
  box.scrollTop = box.scrollHeight;
}

async function adminSendMessage(){
  if(!adminOpenChatUser) return;
  const input = document.getElementById('adminChatInput');
  const text = input.value.trim();
  if(!text) return;
  const thread = await getJSON(chatKey(adminOpenChatUser), []);
  thread.push({ sender:'admin', text, timestamp: new Date().toISOString() });
  await setJSON(chatKey(adminOpenChatUser), thread);
  input.value = '';
  renderAdminChat();
}
document.getElementById('adminChatInput').addEventListener('keydown', e=>{ if(e.key==='Enter') adminSendMessage(); });

/* ============ UTIL ============ */
function escapeHtml(str){
  return String(str).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
}

go('home');
</script>
</body>
</html>
